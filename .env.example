# Copy to ~/.hago-scraper.env and fill in. Never commit the real file.
export HA_ACCOUNT_NAME="your name as it appears in the app"
export DOB_YEAR=1990                 # so a DOB is never read as a collect date
export HAGO_DIR="$HOME/records"      # where renamed PDFs live
export INCOMING_DIR="$HOME/incoming" # where fresh exports arrive
export MEDICAL_DB="$HOME/records/medical.db"
export OLLAMA="http://localhost:11434"

# --- serving -----------------------------------------------------------
# tailscale (default) | localhost | lan | any
export BIND_MODE=tailscale
export PORT=8137
# Required if you listen beyond loopback/tailnet. Generate one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# export AUTH_TOKEN=
# export BEHIND_TLS=1        # when a TLS proxy/tunnel is in front
# export EMBED_MODEL=nomic-embed-text
